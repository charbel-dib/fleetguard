{
  "name": "fleetguard-web",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node scripts/sync-evidence.mjs && vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "node scripts/sync-evidence.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "papaparse": "5.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9"
  }
}
